# Copy to server/.env for local development (npm run dev)
DATABASE_URL=postgres://rsvp:rsvp@localhost:5432/rsvp
PORT=3000
# Local dev runs on plain http
COOKIE_SECURE=false
# Vite dev server origin
ORIGIN=http://localhost:5173

# Used by the server tests (npm test)
TEST_DATABASE_URL=postgres://rsvp:rsvp@localhost:5432/rsvp_test
