# Copy to docker/.env to override the Compose defaults
POSTGRES_PASSWORD=change-me
# Public URL the app is served from (used for the CSRF origin check)
ORIGIN=https://rsvp.example.com
# Keep true behind https and on localhost; false only for plain http on another host
COOKIE_SECURE=true
# true behind a reverse proxy that sets X-Forwarded-For (for login rate limits)
TRUST_PROXY=false
